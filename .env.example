# Optional. Only needed to run the Claude-backed decline-recovery agent.
# Tests, CI and `make demo` use the deterministic stub LLM and need no key.
ANTHROPIC_API_KEY=
# Maximum agent calls per simulation run (cost cap)
AGENT_MAX_CALLS=5000
# Model for the Claude-backed agent (default claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
